{
  "manifest_version": 3,
  "name": "Save Pinned Tabs",
  "short_name": "Save Pinned",
  "version": "3.0.1",

  "description": "Save, restore, autoload, import, and export named groups of pinned tabs.",
  "icons": {
    "128": "images/icon_128.png",
    "64": "images/icon_64.png",
    "32": "images/icon_32.png"
  },

  "permissions": ["tabs", "storage", "favicon"],
  "browser_specific_settings": {
    "gecko": {
      "id": "savepinnedtabs@buildyourweb.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },


  "action": {
    "default_icon": {
      "128": "images/icon_128.png",
      "64": "images/icon_64.png",
      "32": "images/icon_32.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Save pinned tabs"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "commands": {
    "load-set-1": {
      "suggested_key": { "default": "Ctrl+Shift+1", "mac": "Command+Shift+1" },
      "description": "Load assigned tab set 1"
    },
    "load-set-2": {
      "suggested_key": { "default": "Ctrl+Shift+2", "mac": "Command+Shift+2" },
      "description": "Load assigned tab set 2"
    },
    "load-set-3": {
      "suggested_key": { "default": "Ctrl+Shift+3", "mac": "Command+Shift+3" },
      "description": "Load assigned tab set 3"
    },
    "load-set-4": {
      "suggested_key": { "default": "Ctrl+Shift+4", "mac": "Command+Shift+4" },
      "description": "Load assigned tab set 4"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
